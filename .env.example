# Copiar a .env y cambiar TODO. .env esta en .gitignore: nunca se sube al repositorio.
DOMINIO=campussense-unab.northcentralus.cloudapp.azure.com
MQTT_USER=campus
MQTT_PASS=cambiar
ESP32_USER=esp32
ESP32_PASS=cambiar
AMQP_USER=campus
AMQP_PASS=cambiar
INFLUX_USER=admin
INFLUX_PASS=cambiar-min-8
INFLUX_TOKEN=cambiar-token-largo
# lo escribe scripts/crear_token_grafana.sh (token de SOLO LECTURA del bucket campus para Grafana)
INFLUX_TOKEN_GRAFANA=se-genera-con-el-script
GRAFANA_ADMIN_PASS=cambiar
CONTROL_KEY=cambiar          # clave del front para enviar comandos de retroceso
INGEST_TOKEN=cambiar         # token del dispositivo HTTP y del webhook de Grafana
AZMAPS_KEY=                  # clave de Azure Maps (la entrega el docente)
GPS_USER=                    # credenciales de la API GPS de Rutas UNAB (las entrega el docente)
GPS_PASS=
# correo de alertas (Brevo SMTP): login y clave SMTP de app.brevo.com/settings/keys/smtp
SMTP_ENABLED=true
SMTP_USER=xxxxxx@smtp-brevo.com
SMTP_KEY=cambiar
SMTP_FROM=remitente-verificado@ejemplo.com
ALERT_TO=correo1@ejemplo.com,correo2@ejemplo.com
